@model List<ERP_DTO.JobInwardTransaction.ReceiptNoteItem_DTO>

<div class="col table-fixed h-100">
    <div class="w-12 table-responsive table-body table-body-f">

        <table class="table table-one table-striped table-bordered table-hover align-middle w-100" id="ItemTable">

            <!-- ================= HEADER ================= -->
            <thead>
                <tr class="table-info">
                    <th class="px-2 text-center">
                        <input type="checkbox" id="IndexAllCheckItem" class="form-check-input border-white">
                    </th>

                    <th>@Html.DisplayNameFor(m => m.First().JIRNI_PRS_Number)</th>
                    <th>@Html.DisplayNameFor(m => m.First().JIRNI_Item_Number)</th>
                    <th>@Html.DisplayNameFor(m => m.First().Description)</th>

                    <th class="text-end">@Html.DisplayNameFor(m => m.First().OuterDia)</th>
                    <th class="text-end">@Html.DisplayNameFor(m => m.First().Thickness)</th>
                    <th class="text-end">@Html.DisplayNameFor(m => m.First().Length)</th>
                    <th class="text-end">@Html.DisplayNameFor(m => m.First().Width)</th>

                    <th>@Html.DisplayNameFor(m => m.First().MaterialGrade)</th>
                    <th>@Html.DisplayNameFor(m => m.First().ItemGroup)</th>

                    <th>@Html.DisplayNameFor(m => m.First().JIRNI_WH_Number)</th>
                    <th>@Html.DisplayNameFor(m => m.First().JIRNI_UoM_Number)</th>

                    <th class="text-end">@Html.DisplayNameFor(m => m.First().JIRNI_Qty)</th>
                    <th class="text-end">@Html.DisplayNameFor(m => m.First().JIRNI_UnitPrice)</th>
                    <th class="text-end">@Html.DisplayNameFor(m => m.First().JIRNI_Amount)</th>
                </tr>
            </thead>

            <!-- ================= BODY ================= -->
            <tbody id="TableBody">

                <!-- 🔹 TEMPLATE ROW -->
                <tr id="TempRow" style="display:none;">
                    <td><input type="checkbox" class="CheckItem form-check-input"> </td>

                    <td>                     
                        <input   class="JIRNI_PRS_Number" type="hidden" />
                        <input class="form-control PRS_Name" oninput="OnInputProcess(this)"   onfocus="OnFocusProcess(this)" />
                        <div class="search-results card" style="display:none"></div>
                    </td>

                    <td>
                        <input  class="JIRNI_Item_Number" type="hidden" />
                        <input  class="Item_Index" type="hidden" />
                        <input class="form-control Item_Code" oninput="OnInput(this)" onfocus="OnFocus(this)" />
                        <div class="search-results card" style="display:none"></div>
                    </td>

                    <td><input class="form-control Description" readonly /></td>

                    <td><input class="form-control OuterDia text-end" readonly /></td>
                    <td><input class="form-control Thickness text-end" readonly /></td>
                    <td><input class="form-control Length text-end" readonly /></td>
                    <td><input class="form-control Width text-end" readonly /></td>

                    <td><input class="form-control MaterialGrade" readonly /></td>
                    <td><input class="form-control ItemGroup" readonly /></td>

                    <td>
                        <select class="form-select JIRNI_WH_Number" asp-items="@ViewBag.Warehouse"></select>
                    </td>

                    <td>
                        <select class="form-select JIRNI_UoM_Number" asp-items="@ViewBag.UoM"></select>
                    </td>

                    <td>
                        <input class="form-control JIRNI_Qty text-end" />
                    </td>

                    <td>
                        <input class="form-control JIRNI_UnitPrice text-end" />
                    </td>

                    <td>
                        <input class="form-control JIRNI_Amount text-end" readonly />
                        <input type="hidden" class="IsDeleted" value="0" />
                    </td>
                </tr>

                <!-- 🔹 EXISTING DATA -->
                @if (Model != null)
                {
                    for (int i = 0; i < Model.Count; i++)
                    {
                        <tr class="NewRow" style="@(Model[i].IsDeleted == "true" ? "display:none;" : "")">

                            <td>
                                <input type="checkbox" class="CheckItem form-check-input">
                            </td>

                            <td>
                              

                                    <!-- HIDDEN VALUE -->
                                    <input type="hidden"
                                           name="Items[@i].JIRNI_PRS_Number"
                                           class="JIRNI_PRS_Number"
                                           value="@Model[i].JIRNI_PRS_Number" />

                                    <!-- DISPLAY TEXT -->
                                    <input type="text"
                                           class="form-control PRS_Name"
                                           value="@Model[i].PRS_Name"
                                           oninput="OnInputProcess(this)"
                                           onfocus="OnFocusProcess(this)" />

                                    <div class="search-results card" style="display:none"></div>

                               
                            </td>

                            <td>
                                
                                <input type="hidden"
                                       name="Items[@i].RNI_BCH_Item_Number"
                                       class="RNI_BCH_Item_Number"
                                       value="@Model[i].JIRNI_Number">
                                          <input type="hidden" name="Items[@i].JIRNI_Number" class="JIRNI_Number" value="@Model[i].JIRNI_Number">
                                          <input type="hidden" name="Items[@i].JIRNI_JIRNH_Number" class="JIRNI_JIRNH_Number" value="@Model[i].JIRNI_JIRNH_Number">
                                    <!-- HIDDEN VALUE -->
                                    <input type="hidden"
                                           name="Items[@i].JIRNI_Item_Number"
                                           class="JIRNI_Item_Number"
                                           value="@Model[i].JIRNI_Item_Number" />

                                    <!-- DISPLAY TEXT -->
                                    <input type="text"
                                           class="form-control Item_Code"
                                           value="@Model[i].Item_Code"
                                           oninput="OnInput(this)"
                                           onfocus="OnFocus(this)" />

                                    <div class="search-results card" style="display:none"></div>

                                
                            </td>

                            <td>
                                <input name="Items[@i].Description"
                                       class="form-control Description"
                                       value="@Model[i].Description" readonly />
                            </td>

                            <td>
                                <input name="Items[@i].OuterDia"
                                       class="form-control OuterDia text-end"
                                       value="@Model[i].OuterDia" readonly />
                            </td>

                            <td>
                                <input name="Items[@i].Thickness"
                                       class="form-control Thickness text-end"
                                       value="@Model[i].Thickness" readonly />
                            </td>

                            <td>
                                <input name="Items[@i].Length"
                                       class="form-control Length text-end"
                                       value="@Model[i].Length" readonly />
                            </td>

                            <td>
                                <input name="Items[@i].Width"
                                       class="form-control Width text-end"
                                       value="@Model[i].Width" readonly />
                            </td>

                            <td>
                                <input name="Items[@i].MaterialGrade"
                                       class="form-control MaterialGrade"
                                       value="@Model[i].MaterialGrade" readonly />
                            </td>

                            <td>
                                <input name="Items[@i].ItemGroup"
                                       class="form-control ItemGroup"
                                       value="@Model[i].ItemGroup" readonly />
                            </td>

                            <td>
                                <select name="Items[@i].JIRNI_WH_Number" class="form-select JIRNI_WH_Number">
                                    @foreach (var w in (ViewBag.Warehouse as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>()))
                                    {
                                                                        @if (w.Value == Model[i]?.JIRNI_WH_Number)
                                    {
                                        <option value="@w.Value" selected>@w.Text</option>
                                    }
                                    else
                                    {
                                        <option value="@w.Value">@w.Text</option>
                                    }
                                    }
                                </select>
                            </td>

                            <td>
                                <select name="Items[@i].JIRNI_UoM_Number" class="form-select JIRNI_UoM_Number">
                                    @foreach (var u in (ViewBag.UoM as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>()))
                                    {
                                                                               @if (u.Value == Model[i]?.JIRNI_UoM_Number)
                                        {
                                            <option value="@u.Value" selected>@u.Text</option>
                                        }
                                        else
                                        {
                                            <option value="@u.Value">@u.Text</option>
                                        }
                                    }
                                </select>
                            </td>

                            <td>
                                <input name="Items[@i].JIRNI_Qty"
                                       class="form-control JIRNI_Qty text-end"
                                       value="@Model[i].JIRNI_Qty" />
                            </td>

                            <td>
                                <input name="Items[@i].JIRNI_UnitPrice"
                                       class="form-control JIRNI_UnitPrice text-end"
                                       value="@Model[i].JIRNI_UnitPrice" />
                            </td>

                            <td>
                                <input name="Items[@i].JIRNI_Amount"
                                       class="form-control JIRNI_Amount text-end"
                                       value="@Model[i].JIRNI_Amount" readonly />

                                <input type="hidden"
                                       name="Items[@i].IsDeleted"
                                       class="IsDeleted"
                                       value="@Model[i].IsDeleted" />
                            </td>

                        </tr>
                    }
                }

            </tbody>

            <!-- ================= FOOTER ================= -->
            <tfoot>
                <tr class="table-info">
                    <td colspan="12" class="text-end">Total</td>
                    <td>
                        <input id="TotalQty" class="form-control text-end" readonly />
                    </td>
                    <td></td>
                    <td>
                        <input id="TotalAmount" class="form-control text-end" readonly />
                    </td>
                </tr>
            </tfoot>

        </table>
    </div>

    <!-- ================= BUTTONS ================= -->
