    <script src="~/js/jw_serviceorder/JW_ServiceOrder.js" asp-append-version="true"></script>
    <script src="~/js/code/JWC_ItemSearch_Functionality.js" asp-append-version="true"></script>

    <script>
        // Radio toggle: JWI <-> Freight panels
        $(document).ready(function () {
            function toggleServiceTypePanels() {
                var type = $('input[name="ServiceType"]:checked').val();
                if (type === 'FREIGHT') {
                    $('#JWIHeaderPanel').hide();
                    $('#JWIItemTableWrap').hide();
                    $('#FreightHeaderPanel').show();
                    $('#FreightItemTableWrap').show();
                } else {
                    $('#FreightHeaderPanel').hide();
                    $('#FreightItemTableWrap').hide();
                    $('#JWIHeaderPanel').show();
                    $('#JWIItemTableWrap').show();
                }
            }

            $('input[name="ServiceType"]').on('change', toggleServiceTypePanels);
            toggleServiceTypePanels(); // initial state on page load
        });
    </script>
}
