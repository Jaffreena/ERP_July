@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>
        window.JOCNV_Cfg = {
            uom: @Html.Raw(ViewBag.UoMJson ?? "[]"),
            process: @Html.Raw(ViewBag.ProcessJson ?? "[]"),
            workCentre: @Html.Raw(ViewBag.WorkCentreJson ?? "[]")
        };
        $(function () {
            function syncMs() {
                var v = $('#Header_JOCNVH_MS_Number').val();
                $('#JIRNH_MS_Number, #Header_JIDNH_MS_Number').val(v);
            }
            $(document).on('change', '#Header_JOCNVH_MS_Number', syncMs);
            syncMs();
        });
    </script>

