@* Production batch rows - typed by the user, filled/read by JO_Conversion_ItemBatch.js *@
<ul class="nav nav-tabs tab-header" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="overview-tab_P" data-bs-toggle="tab" data-bs-target="#overview-tab-pane_P" type="button" role="tab" aria-controls="overview-tab-pane_P" aria-selected="true">Overview</button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="allwh-tab_P" data-bs-toggle="tab" data-bs-target="#allwh-tab-pane_P" type="button" role="tab" aria-controls="allwh-tab-pane_P" aria-selected="false">All WH</button>
    </li>
</ul>
<div class="tab-content tab-body">

    <!-- Overview -->
    <div class="tab-pane fade show active border border-top-0 h-100 p-2" id="overview-tab-pane_P" role="tabpanel" aria-labelledby="overview-tab_P" tabindex="0">
    <div class="w-100 table-responsive">
        <table class="table table-bordered table-hover align-middle table-grid mb-0">
            <thead>
                <tr class="table-info">
                    <th>Warehouse</th>
                    <th class="datetype text-center">Batch Date</th>
                    <th>Batch Number</th>
                    <th class="text-center">Status</th>
                    <th class="table-width-xl text-center">Qty</th>
                    <th class="table-width-xl text-end">Unit Price</th>
                    <th class="table-width-3xl text-end">Batch Value</th>
                    <th class="action text-center">Action</th>
                </tr>
            </thead>
            <tbody id="IBatTableBody_P">
                <tr id="IBatTempRow" style="display: none;">
                    <td>
                        <select class="form-select JIRNI_BCH_WH_Number">
                            <option value=""></option>
                            @foreach (var o in (IEnumerable<SelectListItem>)ViewBag.Warehouse)
                            {
                                <option value="@o.Value">@o.Text</option>
                            }
                        </select>
                    </td>
                    <td class="datetype">
                        <input class="form-control Key JIRNI_BCH_BatchDate text-center" autocomplete="off" />
                    </td>
                    <td>
                        <input class="form-control JIRNI_BCH_Number" autocomplete="off" maxlength="50" />
                    </td>
                    <td>
                        <input class="form-control JIRNI_BCH_ItemStatus text-center" value="Good" readonly tabindex="-1" />
                    </td>
                    <td class="table-width-xl">
                        <input class="form-control JIRNI_BCH_BatchQty text-center" autocomplete="off" />
                    </td>
                    <td class="table-width-xl">
                        <input class="form-control JIRNI_BCH_BatchUnitPrice text-end" autocomplete="off" />
                    </td>
                    <td class="table-width-3xl">
                        <input class="form-control JIRNI_BCH_BatchValue text-end" readonly autocomplete="off" />
                    </td>
                    <td class="action text-center">
                        <a class="IBatRowRemove text-danger p-0 icon-link shadow-none">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-trash3-fill" viewBox="0 0 16 16">
                                <path d="M11 1.5v1h3.5a.5.5 0 0 1 0 1h-.538l-.853 10.66A2 2 0 0 1 11.115 16h-6.23a2 2 0 0 1-1.994-1.84L2.038 3.5H1.5a.5.5 0 0 1 0-1H5v-1A1.5 1.5 0 0 1 6.5 0h3A1.5 1.5 0 0 1 11 1.5m-5 0v1h4v-1a.5.5 0 0 0-.5-.5h-3a.5.5 0 0 0-.5.5M4.5 5.029l.5 8.5a.5.5 0 1 0 .998-.06l-.5-8.5a.5.5 0 1 0-.998.06m6.53-.528a.5.5 0 0 0-.528.47l-.5 8.5a.5.5 0 0 0 .998.058l.5-8.5a.5.5 0 0 0-.47-.528M8 4.5a.5.5 0 0 0-.5.5v8.5a.5.5 0 0 0 1 0V5a.5.5 0 0 0-.5-.5" />
                            </svg>
                        </a>
                    </td>
                </tr>
            </tbody>
            <tfoot>
                <tr class="table-info">
                    <td class="text-end" colspan="4">Total</td>
                    <td class="table-width-xl">
                        <input id="BatchTotalQty_P" class="form-control text-center" readonly />
                    </td>
                    <td></td>
                    <td class="table-width-3xl">
                        <input id="BatchTotalValue_P" class="form-control text-end" readonly />
                    </td>
                    <td></td>
                </tr>
            </tfoot>
        </table>
    </div>

    </div>

    <!-- All WH -->
    <div class="tab-pane fade border border-top-0 h-100 p-2" id="allwh-tab-pane_P" role="tabpanel" aria-labelledby="allwh-tab_P" tabindex="0">
        <div class="w-100 table-responsive">
            <table id="AllWHBatchList_P" class="table table-bordered table-hover align-middle table-grid mb-0">
                <thead>
                    <tr class="table-info">
                        <th>Warehouse</th>
                        <th class="datetype text-center">Batch Date</th>
                        <th>Batch Number</th>
                        <th class="table-width-xl text-end">Available Qty</th>
                        <th class="table-width-xl text-end">Unit Price</th>
                        <th class="table-width-3xl text-end">Batch Value</th>
                    </tr>
                </thead>
                <tbody id="AllWHBatchTableBody_P">
                    <tr id="AllWHBatchTemplateRow_P" style="display:none;">
                        <td>
                            <input type="hidden" class="JIDNI_BCH_WH_Number">
                            <input type="text" class="form-control JIDNI_BCH_WH_Name" readonly>
                        </td>
                        <td class="datetype"><input type="text" class="form-control text-center JIDNI_BCH_BatchDate" readonly></td>
                        <td><input type="text" class="form-control JIDNI_BCH_BatchNo" readonly></td>
                        <td class="table-width-xl"><input type="text" class="form-control text-end JIDNI_BCH_AvailableQty" readonly></td>
                        <td class="table-width-xl"><input type="text" class="form-control text-end JIDNI_BCH_BatchUnitPrice" readonly></td>
                        <td class="table-width-3xl"><input type="text" class="form-control text-end JIDNI_BCH_BatchValue" readonly></td>
                    </tr>
                </tbody>
                <tfoot>
                    <tr class="table-info">
                        <td colspan="3" class="text-end fw-bold">Total</td>
                        <td><input id="TotalBatchQtyAll_P" class="form-control text-end" readonly></td>
                        <td></td>
                        <td><input id="TotalBatchValueAll_P" class="form-control text-end" readonly></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>

</div>
