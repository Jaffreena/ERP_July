@model ERP_DTO.JobOutwardTransaction.JOFTI_Numbering_DTO

@{
    ViewData["Title"] = "JO Freight Invoice Number Setup";
}
<form id="JOFTI_NumberForm" method="post" class="h-100">

    <div class="row align-items-center panel-header h-auto">
        <div class="col">
            <div class="card rounded-0 mt-3">
                <div class="card-body px-2 py-2">
                    <h1 class="h6 fw-light">
                        JO Freight Invoice Number Setup
                        <a asp-controller="JobworkOutwardMain" asp-action="Index" class="float-end btn p-0">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M2.146 2.854a.5.5 0 1 1 .708-.708L8 7.293l5.146-5.147a.5.5 0 0 1 .708.708L8.707 8l5.147 5.146a.5.5 0 0 1-.708.708L8 8.707l-5.146 5.147a.5.5 0 0 1-.708-.708L7.293 8z" />
                            </svg>
                        </a>
                    </h1>
                </div>
            </div>
        </div>
    </div>

    <div class="row panel-body">
        <div class="col-12 panel-card-fixed h-100" id="BodyHeight">
            <div class="w-100 rounded-0 border border-primary bg-transparent h-100">
                <div class="card rounded-0 bg-transparent shadow-none h-100" id="CardHeader">
                    <div class="card-body pb-0">
                        <div class="row h-100">
                            <div class="col-auto left-menu h-100">
                                <input asp-for="JOFTI_Number" type="hidden" />
                                <div class="row py-3">
                                    <div class="col-12 col-md-3">
                                        <div class="row">
                                            <div class="col text-dark pb-2"><h6>Prefix</h6></div>
                                        </div>
                                        <div class="row">
                                            <partial name="JOFTI_NumberingPrefix.cshtml" model="@Model.JOFTI_NumberPrefix" />
                                        </div>
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <div class="row">
                                            <div class="col text-dark pb-2"><h6>Number</h6></div>
                                        </div>
                                        <div class="row">
                                            <partial name="JOFTI_NumberingReset.cshtml" model="@Model.JOFTI_NumberReset" />
                                        </div>
                                    </div>
                                    <div class="col-12 col-md-3">
                                        <div class="row">
                                            <div class="col text-dark pb-2"><h6>Suffix</h6></div>
                                        </div>
                                        <div class="row">
                                            <partial name="JOFTI_NumberingSuffix.cshtml" model="@Model.JOFTI_NumberSuffix" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-auto right-menu text-center border-start">
                                <input type="submit" name="Mode" value="Submit" class="btn btn-primary btn-sm px-2 w-100 mb-1" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

@if (ViewBag.Error != null)
{
    <script>
        alert(@Html.Raw(System.Text.Json.JsonSerializer.Serialize((string)ViewBag.Error)));
    </script>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/JO_FreightInvoice/JOFTI_Numbering.js" asp-append-version="true"></script>
}
